# Portico needs exactly one environment variable, and `npm run setup`
# generates it for you into .env.local. There are no API keys.

# Signs the session cookie. Any long random string; keep it secret.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Optional: override the admin account `npm run setup` creates.
# ADMIN_EMAIL=admin@portico.dev
# ADMIN_PASSWORD=portico-admin
# ADMIN_NAME=Portal Admin

# Supabase (server-side, bypasses RLS — keep secret)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase (optional, client-side read-only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Direct Postgres connection (portico_app role, bypasses RLS via policies)
SUPABASE_DB_URL=
